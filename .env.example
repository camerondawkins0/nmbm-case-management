# Cloud SQL for Postgres (or local Postgres for dev)
DATABASE_URL=postgres://nmbm:nmbm@localhost:55432/nmbm_cms

# Google OIDC (Workspace SSO) — from a GCP OAuth client, not a personal one
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Session cookie signing secret
SESSION_SECRET=

# Cloud Storage bucket for documents/consent uploads (GCS bucket name, not a URL)
DOCUMENTS_BUCKET=
